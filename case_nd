    </div>
  </div>

  <script>
    // ── Lightbox state ──
    const lightbox      = document.getElementById('lightbox');
    const lightboxImg   = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev  = document.getElementById('lightbox-prev');
    const lightboxNext  = document.getElementById('lightbox-next');

    let currentImages = [];
    let currentIndex  = 0;

    function openLightbox(images, index) {
      currentImages = images;
      currentIndex  = index;
      updateLightbox();
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
      lightboxClose.focus();
      const multi = images.length > 1;
      lightboxPrev.style.display = multi ? 'flex' : 'none';
      lightboxNext.style.display = multi ? 'flex' : 'none';
    }

    function updateLightbox() {
      const { src, title } = currentImages[currentIndex];
      lightboxImg.src = src;
      lightboxImg.alt = title;
      lightboxTitle.textContent = currentImages.length > 1
        ? `${title} (${currentIndex + 1} / ${currentImages.length})`
        : title;
    }

    function closeLightbox() {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
      lightboxImg.src = '';
      currentImages = [];
    }

    lightboxPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
      updateLightbox();
    });

    lightboxNext.addEventListener('click', (e) => {
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % currentImages.length;
      updateLightbox();
    });

    lightboxClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft'  && currentImages.length > 1) { currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length; updateLightbox(); }
      if (e.key === 'ArrowRight' && currentImages.length > 1) { currentIndex = (currentIndex + 1) % currentImages.length; updateLightbox(); }
    });

    // ── "Run through of all pages" filmstrip (01 — Why) ──
    const ndPages = [
      { src: 'IMG_/ND/nd-page1-full.jpg',         title: 'Project ND — 01 Paste It In' },
      { src: 'IMG_/ND/nd-homework-breakdown.jpg', title: 'Project ND — 02 Session Recap' },
      { src: 'IMG_/ND/nd-page3-full.jpg',         title: 'Project ND — 03 Live Session' },
    ];
    document.querySelectorAll('.nd-page-thumb').forEach((btn) => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        openLightbox(ndPages, parseInt(btn.dataset.ndPage, 10));
      });
    });
  </script>

  <script>
    // "Back" link reflects wherever the visitor actually came from — Projects
    // (index.html) or Archive (achive.html) — rather than a single hardcoded
    // page, since every case study is reachable from both.
    (function () {
      var back = document.getElementById('case-back-link');
      if (!back) return;
      try {
        if (document.referrer) {
          var ref = new URL(document.referrer);
          if (ref.origin === window.location.origin) {
            var refFile = ref.pathname.split('/').pop() || 'index.html';
            if (refFile === 'achive.html') {
              back.setAttribute('href', 'achive.html');
              back.textContent = '← Back to Archive';
            }
          }
        }
      } catch (e) { /* leave the default Projects link in place */ }
    })();
  </script>

